PORT=5000
NODE_ENV=development
MONGO_URI=

# Use a long random string, e.g. run:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Where the React app runs (CORS + CSRF origin check). Comma-separate several origins.
CLIENT_URL=http://localhost:5173

# Cookie settings. Keep "lax" when the client and API share a site (the Vite proxy does).
# For a client and API on different domains in production use COOKIE_SAMESITE=none (needs HTTPS).
COOKIE_SAMESITE=lax
# Set to true when the API runs behind a reverse proxy (Render, Railway, Nginx).
TRUST_PROXY=false

# Used only by the admin seed script (npm run seed:admin)
ADMIN_FULL_NAME=Admin
ADMIN_USERNAME= 
ADMIN_PASSWORD=
ADMIN_DOB=01/01/1990
ADMIN_PHONE=9999999999
ADMIN_GENDER=Other
